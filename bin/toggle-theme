#!/usr/bin/env bash
# Toggle alacritty, tmux, and neovim between one-light and one-dark
# Usage: toggle-theme [light|dark]
#   If no argument given, toggles based on the current theme.
#
# The live theme for alacritty and tmux is a generated, gitignored file
# (theme-current.*) copied from one of the tracked theme-* variants. Nothing
# tracked gets rewritten, so a `git pull` never collides with the theme state.

DOTFILES="$HOME/.dotfiles"
ALACRITTY_THEME="$DOTFILES/config/alacritty/theme-current.toml"
TMUX_THEME="$DOTFILES/tmux/theme-current.sh"

# Auto-detect current mode if no argument given
if [ -z "$1" ]; then
    if grep -q 'one-light' "$ALACRITTY_THEME" 2>/dev/null; then
        MODE="dark"
    else
        MODE="light"
    fi
else
    MODE="$1"
fi

# Alacritty: swap the imported theme (live_config_reload picks it up)
cp "$DOTFILES/config/alacritty/themes/one-$MODE.toml" "$ALACRITTY_THEME"

# Tmux: swap theme and reload
cp "$DOTFILES/tmux/theme-$MODE.sh" "$TMUX_THEME"
tmux source-file ~/.tmux.conf 2>/dev/null

# Neovim: switch all running instances
for sock in $(find /var/folders /tmp -path '*/nvim.*/nvim.*.0' -type s 2>/dev/null); do
    nvim --server "$sock" --remote-expr \
        "execute('set background=$MODE | colorscheme one')" 2>/dev/null &
done
wait
