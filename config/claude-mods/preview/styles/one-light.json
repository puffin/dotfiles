{
  "document": {
    "block_prefix": "\n",
    "block_suffix": "\n",
    "color": "#2a2b33",
    "margin": 2
  },
  "block_quote": {
    "indent": 1,
    "indent_token": "│ ",
    "color": "#7c6f64",
    "italic": true
  },
  "paragraph": {},
  "list": {
    "level_indent": 2
  },
  "heading": {
    "block_suffix": "\n",
    "color": "#2f5af3",
    "bold": true
  },
  "h1": {
    "prefix": " ",
    "suffix": " ",
    "color": "#f8f8f8",
    "background_color": "#2f5af3",
    "bold": true
  },
  "h2": {
    "prefix": "▍ ",
    "color": "#2f5af3",
    "bold": true
  },
  "h3": {
    "prefix": "▍ ",
    "color": "#b16286",
    "bold": true
  },
  "h4": {
    "prefix": "▍ ",
    "color": "#689d6a",
    "bold": true
  },
  "h5": {
    "prefix": "▍ ",
    "color": "#3e953a",
    "bold": true
  },
  "h6": {
    "prefix": "▍ ",
    "color": "#7c6f64",
    "bold": true
  },
  "text": {},
  "strikethrough": {
    "crossed_out": true
  },
  "emph": {
    "italic": true
  },
  "strong": {
    "bold": true
  },
  "hr": {
    "color": "#d4d4d4",
    "format": "\n────────\n"
  },
  "item": {
    "block_prefix": "• "
  },
  "enumeration": {
    "block_prefix": ". "
  },
  "task": {
    "ticked": "[✓] ",
    "unticked": "[ ] "
  },
  "link": {
    "color": "#689d6a",
    "underline": true
  },
  "link_text": {
    "color": "#2f5af3",
    "bold": true
  },
  "image": {
    "color": "#689d6a",
    "underline": true
  },
  "image_text": {
    "color": "#7c6f64",
    "format": "Image: {{.text}} →"
  },
  "code": {
    "prefix": " ",
    "suffix": " ",
    "color": "#de3d35",
    "background_color": "#ececec"
  },
  "code_block": {
    "color": "#2a2b33",
    "margin": 2,
    "chroma": {
      "text": {
        "color": "#2a2b33"
      },
      "error": {
        "color": "#de3d35"
      },
      "comment": {
        "color": "#7c6f64",
        "italic": true
      },
      "comment_preproc": {
        "color": "#7c6f64"
      },
      "keyword": {
        "color": "#b16286"
      },
      "keyword_reserved": {
        "color": "#b16286"
      },
      "keyword_namespace": {
        "color": "#b16286"
      },
      "keyword_type": {
        "color": "#b57614"
      },
      "operator": {
        "color": "#689d6a"
      },
      "punctuation": {
        "color": "#2a2b33"
      },
      "name": {
        "color": "#2a2b33"
      },
      "name_builtin": {
        "color": "#689d6a"
      },
      "name_tag": {
        "color": "#de3d35"
      },
      "name_attribute": {
        "color": "#b57614"
      },
      "name_class": {
        "color": "#b57614"
      },
      "name_constant": {
        "color": "#b57614"
      },
      "name_decorator": {
        "color": "#2f5af3"
      },
      "name_exception": {
        "color": "#de3d35"
      },
      "name_function": {
        "color": "#2f5af3"
      },
      "name_other": {
        "color": "#de3d35"
      },
      "literal": {
        "color": "#b57614"
      },
      "literal_number": {
        "color": "#b57614"
      },
      "literal_date": {
        "color": "#b57614"
      },
      "literal_string": {
        "color": "#3e953a"
      },
      "literal_string_escape": {
        "color": "#689d6a"
      },
      "generic_deleted": {
        "color": "#de3d35"
      },
      "generic_emph": {
        "italic": true
      },
      "generic_inserted": {
        "color": "#3e953a"
      },
      "generic_strong": {
        "bold": true
      },
      "generic_subheading": {
        "color": "#7c6f64"
      },
      "background": {
        "background_color": "#ececec"
      }
    }
  },
  "table": {
    "color": "#2a2b33"
  },
  "definition_list": {},
  "definition_term": {},
  "definition_description": {
    "block_prefix": "\n→ "
  },
  "html_block": {},
  "html_span": {}
}
